//@version=6
indicator("Keen's Indicator v2.1", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ============================================================================
// KEEN'S INDICATOR v2.1
// ============================================================================
// Pattern: sweep of an Asia/London high or low -> reversal confirmed by a
// close through the FVG formed on the approach into that sweep -> that FVG
// inverts (flips role) -> entry on retracement into it -> SL and TP both set
// at slShrinkFactor x the entry-to-swept-level distance, keeping the same
// fixedRTarget ratio between them (default: opposing liquidity pool targets
// were mostly directionally right but rarely travelled far enough to reach
// a far pool before reversing - a fixed, tightened target converts a lot of
// those into realized wins instead).
// Built for the 1-minute and 5-minute chart.
//
// Backtest history (see src/liquidity_fvg_backtest.py), 2023-01 through
// 2026-07 MNQ 1m, tick-verified against Databento trade-level price data:
//   - v1 design (TP = nearest untapped opposing session level): 758 trades,
//     20.2% win rate, avg R 0.49, total R 370.8, PF 1.61.
//   - shrink=0.5/target=2.0 (an earlier candidate, NOT the default - kept
//     here only so the two don't get confused again): 1,887 trades, 55.2%
//     win rate, PF 2.47 combined. Never checked year-by-year independently.
//   - CURRENT DEFAULT (slShrinkFactor=0.7, fixedRTarget=1.5): 1,892 trades,
//     61.1% win rate, PF 2.36, total R 998, max drawdown 10R - combined
//     across 2023-01 through 2026-07. Checked independently, year by year,
//     and it barely moves: 2023 61.3%/PF 2.37, 2024 61.6%/PF 2.40, 2025
//     60.6%/PF 2.31, 2026 YTD 60.8%/PF 2.33 - 42 of 43 months profitable,
//     the other exactly breakeven, zero losing months anywhere in 3.5 years.
//     That year-by-year consistency is why this is the default, not the
//     0.5/2.0 combined number above - a combined number can hide a result
//     that was only good in one stretch, and this one isn't that.
//   - Entry/SL/TP are rounded to the instrument's tick size before use
//     (math.round_to_mintick) - at this tightness, unrounded price math can
//     produce theoretical distances smaller than one tick, which aren't
//     placeable as real orders.
//   - Known open risk: position sizing still gets heavier on the tightest-
//     stop trades if you're sizing to a fixed dollar risk - cap your own
//     position size in practice (see src/bot/sizing.py's max_contracts)
//     rather than blindly scaling up to hit a fixed risk target every trade.
//   - The NY-AM-hours and 10-20x-RR-band filters below were validated
//     against the v1 liquidity-pool-target design and only apply when
//     useFixedRTarget is off - not used by the current default. A NY-AM-only
//     filter was tested against the current default and made results worse,
//     not better - left off.
//   - v2.2 additions (see grpV22 inputs below), floor-tested on both years
//     independently but not yet tick-verified: requiring a fast confirm+
//     retest (a real V-shaped reversal, not a setup drifting for hours),
//     picking the largest FVG among recent candidates instead of whichever
//     formed last, and requiring the FVG be a meaningful size relative to
//     recent volatility. Combined floor result: ~57-59% win rate, PF ~2.7-
//     2.9, ~100-124 trades/year, both years independently - promising, but
//     OFF by default until they get the same tick-level verification the
//     base config has (which now spans FOUR independent years - 2023: 61.3%
//     win rate/PF 2.37, 2024: 61.6%/2.40, 2025: 60.6%/2.31, 2026 YTD:
//     60.8%/2.33 - essentially flat across every one of them, 42 of 43
//     months profitable, the other exactly breakeven). Turn
//     useConfirmRetestTimeout / useSmartFvgSelection / useFvgHeightFilter
//     back on only if you specifically want to try the untested variant.
// ============================================================================

grpGeneral    = "General"
sessTz        = input.string("America/New_York", "Session Timezone", group = grpGeneral)
asiaSession   = input.session("1800-0000", "Asia Session Time", group = grpGeneral)
londonSession = input.session("0200-0500", "London Session Time", group = grpGeneral)
atrLen        = input.int(14, "ATR Length (label offset only)", group = grpGeneral)

grpTarget      = "Target"
useFixedRTarget = input.bool(true, "Use fixed R target (instead of opposing liquidity pool)", group = grpTarget)
fixedRTarget    = input.float(1.5, "Fixed R Target", step = 0.5, group = grpTarget)
slShrinkFactor  = input.float(0.7, "SL/TP Shrink Factor (1.0 = full swept-level distance)", step = 0.1, minval = 0.05, maxval = 1.0, group = grpTarget)

grpFilt        = "Filters (walk-forward validated)"
useTimeFilter  = input.bool(false, "Only trade NY AM hours", group = grpFilt)
tradingStartHr = input.int(7, "Trading Window Start Hour (NY, inclusive)", group = grpFilt)
tradingEndHr   = input.int(10, "Trading Window End Hour (NY, inclusive)", group = grpFilt)
useRRFilter    = input.bool(false, "Skip 10-20x reward:risk band (liquidity-pool target mode only)", group = grpFilt)
avoidRRMin     = input.float(10.0, "Avoid RR Min", group = grpFilt)
avoidRRMax     = input.float(20.0, "Avoid RR Max", group = grpFilt)

// Floor-tested on 2023-2026 MNQ 1m (consistent both years independently),
// but NOT yet tick-verified against real trade-level price data the way
// the shrink/target defaults above were - see src/liquidity_fvg_strategy.py
// (max_bars_awaiting_confirm/retest, fvg_selection_window, FVG-height
// ratio). Combined floor result: ~57-59% win rate, PF ~2.7-2.9, ~100-124
// trades/year (both years independently) - NOTE: that comparison was run
// against the OLDER shrink=0.5/target=2.0 base, not the current
// shrink=0.7/target=1.5 default, so treat the improvement margin as
// unconfirmed until re-tested against the actual current base. OFF by
// default regardless - the plain 0.7/1.5 base above is the one with four
// full years of independent tick-verified confirmation behind it; switch
// these on only if you want to experiment with the unverified variant.
grpV22         = "v2.2 additions (floor-tested, not yet tick-verified - OFF by default)"
useConfirmRetestTimeout = input.bool(false, "Require fast confirm+retest (V-shaped reversal)", group = grpV22)
maxBarsAwaitingConfirm  = input.int(30, "Max bars waiting for confirmation", group = grpV22)
maxBarsAwaitingRetest   = input.int(30, "Max bars waiting for retest after confirm", group = grpV22)
useSmartFvgSelection    = input.bool(false, "Pick largest recent FVG instead of most-recent", group = grpV22)
fvgSelectionWindow      = input.int(30, "FVG selection lookback window (bars)", group = grpV22)
useFvgHeightFilter      = input.bool(false, "Require FVG height >= X * recent avg bar range", group = grpV22)
fvgHeightMinRatio       = input.float(0.7, "Min FVG height ratio", step = 0.1, group = grpV22)
avgRangeLength          = input.int(50, "Avg bar range lookback (for FVG height ratio)", group = grpV22)

grpAlerts       = "Alerts"
alertCooldownBars = input.int(15, "Min bars between 'armed' pings (notification-only, does not affect trading)", group = grpAlerts)

grpVis         = "Visuals"
showStatsTable = input.bool(true, "Show stats table", group = grpVis)
debugTable     = input.bool(false, "Show debug table (verification only)", group = grpVis)
showFvgBox     = input.bool(true, "Show tracked FVG box", group = grpVis)

atrVal = ta.atr(atrLen)

// ----------------------------------------------------------------------------
// Session high/low tracker - tracked internally only (no chart clutter),
// plus edge-triggered "just swept" flags used to anchor a new setup the
// instant a sweep happens. Resets every day.
// ----------------------------------------------------------------------------
f_sessionLevels(sessString, tz) =>
    var float sHigh   = na
    var float sLow    = na
    var bool  active  = false
    var bool  hSwept  = false
    var bool  lSwept  = false

    t    = time(timeframe.period, sessString, tz)
    isIn = not na(t)

    justHighSwept = false
    justLowSwept  = false

    if isIn and not active
        sHigh  := high
        sLow   := low
        active := true
    else if isIn and active
        sHigh := math.max(sHigh, high)
        sLow  := math.min(sLow, low)
    else if not isIn and active
        active := false
        hSwept := false
        lSwept := false

    if not active and not na(sHigh)
        if not hSwept and high > sHigh
            hSwept := true
            justHighSwept := true
        if not lSwept and low < sLow
            lSwept := true
            justLowSwept := true

    [sHigh, sLow, hSwept, lSwept, justHighSwept, justLowSwept]

[asiaHigh, asiaLow, asiaHighSwept, asiaLowSwept, asiaHighJustSwept, asiaLowJustSwept] = f_sessionLevels(asiaSession, sessTz)
[londonHigh, londonLow, londonHighSwept, londonLowSwept, londonHighJustSwept, londonLowJustSwept] = f_sessionLevels(londonSession, sessTz)

var float midnightOpen = na
nyHour        = hour(time, sessTz)
isMidnightBar = nyHour == 0 and (na(nyHour[1]) or nyHour[1] != 0)
if isMidnightBar
    midnightOpen := open

// ----------------------------------------------------------------------------
// FVG tracking - a rolling pool of untapped gaps, bullish and bearish kept
// separately. Standard 3-candle definition.
// ----------------------------------------------------------------------------
type FVG
    float top
    float bottom
    int   barIndex

var array<FVG> pendingBull = array.new<FVG>()
var array<FVG> pendingBear = array.new<FVG>()

isBullFVG = high[2] < low
isBearFVG = low[2] > high

if isBullFVG
    array.push(pendingBull, FVG.new(low, high[2], bar_index))
if isBearFVG
    array.push(pendingBear, FVG.new(low[2], high, bar_index))

// prune gaps that have since been fully filled
if array.size(pendingBull) > 0
    for i = array.size(pendingBull) - 1 to 0
        f = array.get(pendingBull, i)
        if close < f.bottom
            array.remove(pendingBull, i)

if array.size(pendingBear) > 0
    for i = array.size(pendingBear) - 1 to 0
        f = array.get(pendingBear, i)
        if close > f.top
            array.remove(pendingBear, i)

// ----------------------------------------------------------------------------
// Setup + trade state
// ----------------------------------------------------------------------------
var string setupDir        = na     // "long" or "short"
var FVG    setupFVG        = na
var float  setupSL         = na
var float  setupEntry      = na
var float  setupTP         = na
var bool   awaitingConfirm = false
var bool   awaitingRetest  = false
var int    setupAnchorBar  = na
var int    setupConfirmBar = na

avgBarRange = ta.sma(high - low, avgRangeLength)

// v2.2: pick the largest FVG among recent candidates instead of always the
// most-recently-formed one - see grpV22 inputs above. Falls back to the
// plain most-recent pick if nothing in the array is within the window.
f_selectFvg(arr) =>
    FVG selected = na
    if useSmartFvgSelection and array.size(arr) > 0
        int bestIdx = -1
        float bestHeight = -1.0
        for idx = 0 to array.size(arr) - 1
            f = array.get(arr, idx)
            if f.barIndex >= bar_index - fvgSelectionWindow
                height = f.top - f.bottom
                if height > bestHeight
                    bestHeight := height
                    bestIdx := idx
        if bestIdx >= 0
            selected := array.get(arr, bestIdx)
            array.remove(arr, bestIdx)
        else
            selected := array.get(arr, array.size(arr) - 1)
            array.remove(arr, array.size(arr) - 1)
    else
        selected := array.get(arr, array.size(arr) - 1)
        array.remove(arr, array.size(arr) - 1)
    selected

var bool  tradeActive   = false
var bool  tradeIsLong   = false
var float tradeEntry    = na
var float tradeSL       = na
var float tradeTP       = na
var int   tradeEntryBar = na

var int wins   = 0
var int losses = 0
var int skippedNoTarget  = 0
var int skippedByFilter  = 0
var int skippedFvgTooSmall = 0

f_passesFvgHeightFilter(fvg) =>
    not useFvgHeightFilter or (fvg.top - fvg.bottom) >= fvgHeightMinRatio * avgBarRange

f_passesFilters(entryPrice, slPrice, tpPrice) =>
    timeOk = not useTimeFilter or (nyHour >= tradingStartHr and nyHour <= tradingEndHr)
    plannedRR = math.abs(tpPrice - entryPrice) / math.abs(entryPrice - slPrice)
    rrOk = not useRRFilter or not (plannedRR >= avoidRRMin and plannedRR <= avoidRRMax)
    timeOk and rrOk

lowSweptNow    = asiaLowJustSwept or londonLowJustSwept
highSweptNow   = asiaHighJustSwept or londonHighJustSwept
sweptLowLevel  = asiaLowJustSwept ? asiaLow : londonLow
sweptHighLevel = asiaHighJustSwept ? asiaHigh : londonHigh

f_nearestUntappedHigh() =>
    float best = na
    if not asiaHighSwept
        best := asiaHigh
    if not londonHighSwept
        best := na(best) ? londonHigh : math.min(best, londonHigh)
    best

f_nearestUntappedLow() =>
    float best = na
    if not asiaLowSwept
        best := asiaLow
    if not londonLowSwept
        best := na(best) ? londonLow : math.max(best, londonLow)
    best

// anchor a new long setup off a fresh low sweep (only when flat)
if lowSweptNow and not awaitingConfirm and not awaitingRetest and not tradeActive and array.size(pendingBear) > 0
    setupFVG := f_selectFvg(pendingBear)
    setupDir        := "long"
    setupSL         := sweptLowLevel
    awaitingConfirm := true
    setupAnchorBar  := bar_index

// anchor a new short setup off a fresh high sweep (only when flat)
if highSweptNow and not awaitingConfirm and not awaitingRetest and not tradeActive and array.size(pendingBull) > 0
    setupFVG := f_selectFvg(pendingBull)
    setupDir        := "short"
    setupSL         := sweptHighLevel
    awaitingConfirm := true
    setupAnchorBar  := bar_index

// a sweep on the opposite side before we confirm invalidates the thesis.
// justInvalidated only fires if a limit order was actually armed (awaitingRetest) -
// that's the case where you have a real resting order to go cancel.
var bool justInvalidated = false
justInvalidated := false

if awaitingConfirm or awaitingRetest
    if setupDir == "long" and highSweptNow
        if awaitingRetest
            justInvalidated := true
        awaitingConfirm := false
        awaitingRetest  := false
        setupFVG        := na
    else if setupDir == "short" and lowSweptNow
        if awaitingRetest
            justInvalidated := true
        awaitingConfirm := false
        awaitingRetest  := false
        setupFVG        := na

// v2.2: a setup that's taken too long to confirm or retest expires outright,
// same reset as an opposite-side invalidation - requires the fast, sharp
// V-shaped reversal specifically, not a setup that's been drifting for
// hours before finally triggering.
if useConfirmRetestTimeout
    if awaitingConfirm and (bar_index - setupAnchorBar) > maxBarsAwaitingConfirm
        if awaitingRetest
            justInvalidated := true
        awaitingConfirm := false
        awaitingRetest  := false
        setupFVG        := na
    else if awaitingRetest and (bar_index - setupConfirmBar) > maxBarsAwaitingRetest
        justInvalidated := true
        awaitingConfirm := false
        awaitingRetest  := false
        setupFVG        := na

// reversal confirmation: close through the approach-leg FVG. If there's no
// untapped opposing level to use as a target, drop the setup instead of
// proceeding - otherwise the trade sits open forever (a "hit TP" check
// against na never fires), never losing, which was quietly inflating the
// win rate with trades that never had a real chance to lose.
var bool justArmed = false
justArmed := false

// gated on barstate.isconfirmed: `close` on the still-forming bar is just
// "current price" and can cross setupFVG.top/bottom and cross back before
// the bar actually closes - without this gate, confirmation (and the alert
// it fires) can provisionally trigger and then not actually be true once
// the bar settles. Costs a small delay (up to one bar) in exchange for
// never firing a signal that the close would have contradicted.
if awaitingConfirm and not na(setupFVG) and barstate.isconfirmed
    if setupDir == "long" and close > setupFVG.top
        entryCandidate = math.round_to_mintick((setupFVG.top + setupFVG.bottom) / 2)
        // slShrinkFactor moves the stop closer to entry (1.0 = unchanged, at
        // the swept level; 0.5 = 50% of that distance) - only in fixed-R
        // mode, since it's defined relative to fixedRTarget's ratio.
        effectiveSL = useFixedRTarget ? math.round_to_mintick(entryCandidate - slShrinkFactor * (entryCandidate - setupSL)) : setupSL
        tp = useFixedRTarget ? math.round_to_mintick(entryCandidate + fixedRTarget * math.abs(entryCandidate - effectiveSL)) : f_nearestUntappedHigh()
        awaitingConfirm := false
        if na(tp)
            setupFVG := na
            skippedNoTarget += 1
        else if not f_passesFilters(entryCandidate, effectiveSL, tp)
            setupFVG := na
            skippedByFilter += 1
        else if not f_passesFvgHeightFilter(setupFVG)
            setupFVG := na
            skippedFvgTooSmall += 1
        else
            awaitingRetest := true
            setupEntry := entryCandidate
            setupSL    := effectiveSL
            setupTP    := tp
            setupConfirmBar := bar_index
            justArmed  := true
    else if setupDir == "short" and close < setupFVG.bottom
        entryCandidate = math.round_to_mintick((setupFVG.top + setupFVG.bottom) / 2)
        effectiveSL = useFixedRTarget ? math.round_to_mintick(entryCandidate + slShrinkFactor * (setupSL - entryCandidate)) : setupSL
        tp = useFixedRTarget ? math.round_to_mintick(entryCandidate - fixedRTarget * math.abs(entryCandidate - effectiveSL)) : f_nearestUntappedLow()
        awaitingConfirm := false
        if na(tp)
            setupFVG := na
            skippedNoTarget += 1
        else if not f_passesFilters(entryCandidate, effectiveSL, tp)
            setupFVG := na
            skippedByFilter += 1
        else if not f_passesFvgHeightFilter(setupFVG)
            setupFVG := na
            skippedFvgTooSmall += 1
        else
            awaitingRetest := true
            setupEntry := entryCandidate
            setupSL    := effectiveSL
            setupTP    := tp
            setupConfirmBar := bar_index
            justArmed  := true

// entry trigger: retracement back into the inverted FVG
var bool justEntered = false
justEntered := false

if awaitingRetest and not na(setupFVG)
    inZone = low <= setupFVG.top and high >= setupFVG.bottom
    if inZone
        justEntered    := true
        awaitingRetest := false

if justEntered
    tradeActive   := true
    tradeIsLong   := setupDir == "long"
    tradeEntry    := setupEntry
    tradeSL       := setupSL
    tradeTP       := setupTP
    tradeEntryBar := bar_index
    setupFVG      := na

    dirTxt = tradeIsLong ? "🟢 LONG" : "🔴 SHORT"
    txt = dirTxt + "\n📍 Entry " + str.tostring(tradeEntry, format.mintick) + "\n🛑 SL " + str.tostring(tradeSL, format.mintick) + "\n🎯 TP " + str.tostring(tradeTP, format.mintick)
    label.new(bar_index, tradeIsLong ? low - atrVal * 0.75 : high + atrVal * 0.75, txt,
      style = tradeIsLong ? label.style_label_up : label.style_label_down,
      color = color.new(tradeIsLong ? color.green : color.red, 0), textcolor = color.white, size = size.small)

// ----------------------------------------------------------------------------
// Trade lines while active
// ----------------------------------------------------------------------------
var line entryLine = na
var line slLine    = na
var line tpLine    = na
var box  fvgBox    = na

// extend.right while active - keeps a clearly visible, unobstructed segment
// out past the current price action rather than only existing tangled up
// inside the exact candle cluster where price is fighting for SL/TP.
if justEntered
    entryLine := line.new(tradeEntryBar, tradeEntry, bar_index, tradeEntry, color = color.white, style = line.style_dotted, width = 3, extend = extend.right)
    slLine    := line.new(tradeEntryBar, tradeSL, bar_index, tradeSL, color = color.red, style = line.style_dotted, width = 3, extend = extend.right)
    tpLine    := line.new(tradeEntryBar, tradeTP, bar_index, tradeTP, color = color.lime, style = line.style_dotted, width = 3, extend = extend.right)

// ----------------------------------------------------------------------------
// Resolve win/loss - SL takes priority if both are touched on the same bar
// (can't know intrabar order from OHLC alone, so assume the worst case).
// Gated on barstate.isconfirmed for the same reason as confirmation above -
// evaluating hitSL/hitTP mid-bar, before the bar's true final high/low are
// locked in, is what let a trade show as a win, then flip to a loss once
// the bar's full range (which touched BOTH levels) was fully known. Waiting
// for the close means it only ever resolves once, correctly, no flicker.
// ----------------------------------------------------------------------------
bool   tradeClosed = false
string closeText   = na
float  closeR      = na

if tradeActive and barstate.isconfirmed
    hitSL = tradeIsLong ? low <= tradeSL : high >= tradeSL
    hitTP = tradeIsLong ? high >= tradeTP : low <= tradeTP
    if hitSL
        losses += 1
        tradeClosed := true
        closeR      := -1.0
        closeText   := "❌ LOSS"
        tradeActive := false
    else if hitTP
        wins += 1
        risk = math.abs(tradeEntry - tradeSL)
        r    = risk > 0 ? (tradeIsLong ? (tradeTP - tradeEntry) / risk : (tradeEntry - tradeTP) / risk) : na
        tradeClosed := true
        closeR      := r
        closeText   := "✅ WIN" + (na(r) ? "" : " " + str.tostring(r, "#.00") + "R")
        tradeActive := false

if tradeClosed
    label.new(bar_index, closeR > 0 ? high + atrVal : low - atrVal, closeText,
      style = closeR > 0 ? label.style_label_down : label.style_label_up,
      color = color.new(closeR > 0 ? color.green : color.red, 0), textcolor = color.white, size = size.small)
    // freeze a bit past the close bar (not exactly on it) instead of
    // extending forever, so a resolved trade's lines stay put with some
    // visible runway for later review rather than stopping right at the
    // edge of the candle cluster that resolved it
    line.set_extend(entryLine, extend.none)
    line.set_extend(slLine, extend.none)
    line.set_extend(tpLine, extend.none)
    line.set_x2(entryLine, bar_index + 20)
    line.set_x2(slLine, bar_index + 20)
    line.set_x2(tpLine, bar_index + 20)
    entryLine := na
    slLine    := na
    tpLine    := na

resolvedTrades = wins + losses
winrate = resolvedTrades > 0 ? wins * 100.0 / resolvedTrades : na

// ----------------------------------------------------------------------------
// Tracked FVG box - draws the exact gap currently anchored as setupFVG, from
// awaiting-confirm through awaiting-retest, so you can see on the chart
// which specific FVG the indicator is using at any given moment (its size,
// freshness, whether it's been touched before, etc.). Freezes in place once
// the setup resolves (entered or invalidated) rather than disappearing, so
// past setups stay visible for review; a fresh box starts on the next one.
// ----------------------------------------------------------------------------
if showFvgBox
    if not na(setupFVG)
        boxColor = setupDir == "long" ? color.new(color.teal, 85) : color.new(color.maroon, 85)
        borderColor = setupDir == "long" ? color.teal : color.maroon
        if na(fvgBox)
            fvgBox := box.new(setupFVG.barIndex, setupFVG.top, bar_index, setupFVG.bottom,
              border_color = borderColor, bgcolor = boxColor, border_width = 1, border_style = line.style_dashed)
        else
            box.set_right(fvgBox, bar_index)
    else if not na(fvgBox)
        fvgBox := na

// ----------------------------------------------------------------------------
// Dashboard
// ----------------------------------------------------------------------------
chartTfOk = timeframe.period == "1" or timeframe.period == "5"

f_dirText(dir) => dir == "long" ? "🟢 LONG" : dir == "short" ? "🔴 SHORT" : "— none —"
f_dirColor(dir) => dir == "long" ? color.lime : dir == "short" ? color.red : color.gray

if showStatsTable and barstate.islast
    var table dash = table.new(position.top_right, 2, 9, border_width = 1, border_color = #000000, frame_width = 1, frame_color = #000000, bgcolor = #131722)
    bgSolid = #131722
    stateText = tradeActive ? "💰 Trade Active" : awaitingRetest ? "⏳ Awaiting retest" : awaitingConfirm ? "🔎 Awaiting confirm" : "🔍 Searching"

    table.cell(dash, 0, 0, "Keen's Indicator v2.1", text_color = color.white, bgcolor = #1e2a3a, text_size = size.tiny)
    table.cell(dash, 1, 0, syminfo.ticker + " " + timeframe.period + (chartTfOk ? "" : " ⚠"), text_color = color.white, bgcolor = #1e2a3a, text_size = size.tiny)

    table.cell(dash, 0, 1, "Status", text_color = color.white, bgcolor = bgSolid, text_size = size.tiny)
    table.cell(dash, 1, 1, stateText, text_color = color.white, bgcolor = bgSolid, text_size = size.tiny)

    table.cell(dash, 0, 2, "Setup Dir", text_color = color.white, bgcolor = bgSolid, text_size = size.tiny)
    table.cell(dash, 1, 2, f_dirText(setupDir), text_color = f_dirColor(setupDir), bgcolor = bgSolid, text_size = size.tiny)

    table.cell(dash, 0, 3, "Entry / SL / TP", text_color = color.white, bgcolor = bgSolid, text_size = size.tiny)
    table.cell(dash, 1, 3, (na(tradeEntry) ? "-" : str.tostring(tradeEntry, format.mintick)) + " / " + (na(tradeSL) ? "-" : str.tostring(tradeSL, format.mintick)) + " / " + (na(tradeTP) ? "-" : str.tostring(tradeTP, format.mintick)), text_color = color.white, bgcolor = bgSolid, text_size = size.tiny)

    table.cell(dash, 0, 4, "Record", text_color = color.white, bgcolor = bgSolid, text_size = size.tiny)
    table.cell(dash, 1, 4, str.tostring(wins) + "W " + str.tostring(losses) + "L (" + (not na(winrate) ? str.tostring(winrate, "#.0") + "%" : "N/A") + ")", text_color = color.white, bgcolor = bgSolid, text_size = size.tiny)

    table.cell(dash, 0, 5, "Skipped (no target)", text_color = color.white, bgcolor = bgSolid, text_size = size.tiny)
    table.cell(dash, 1, 5, str.tostring(skippedNoTarget), text_color = color.gray, bgcolor = bgSolid, text_size = size.tiny)

    table.cell(dash, 0, 6, "Skipped (filtered)", text_color = color.white, bgcolor = bgSolid, text_size = size.tiny)
    table.cell(dash, 1, 6, str.tostring(skippedByFilter), text_color = color.gray, bgcolor = bgSolid, text_size = size.tiny)

    table.cell(dash, 0, 7, "Skipped (FVG too small)", text_color = color.white, bgcolor = bgSolid, text_size = size.tiny)
    table.cell(dash, 1, 7, str.tostring(skippedFvgTooSmall), text_color = color.gray, bgcolor = bgSolid, text_size = size.tiny)

    table.cell(dash, 0, 8, "Timeframe", text_color = color.white, bgcolor = bgSolid, text_size = size.tiny)
    table.cell(dash, 1, 8, chartTfOk ? "OK (" + timeframe.period + "m)" : "⚠ built for 1m/5m", text_color = chartTfOk ? color.lime : color.orange, bgcolor = bgSolid, text_size = size.tiny)

// ----------------------------------------------------------------------------
// Optional debug table - off by default, verification only.
// ----------------------------------------------------------------------------
var table dbg = table.new(position.bottom_right, 2, 5, border_width = 1)

if debugTable and barstate.islast
    table.cell(dbg, 0, 0, "Level", bgcolor = color.gray)
    table.cell(dbg, 1, 0, "Value", bgcolor = color.gray)
    table.cell(dbg, 0, 1, "Asia H/L" + (asiaHighSwept or asiaLowSwept ? " (swept: " + (asiaHighSwept ? "H" : "") + (asiaLowSwept ? "L" : "") + ")" : ""))
    table.cell(dbg, 1, 1, str.tostring(asiaHigh) + " / " + str.tostring(asiaLow))
    table.cell(dbg, 0, 2, "London H/L" + (londonHighSwept or londonLowSwept ? " (swept: " + (londonHighSwept ? "H" : "") + (londonLowSwept ? "L" : "") + ")" : ""))
    table.cell(dbg, 1, 2, str.tostring(londonHigh) + " / " + str.tostring(londonLow))
    table.cell(dbg, 0, 3, "Midnight Open")
    table.cell(dbg, 1, 3, str.tostring(midnightOpen))
    table.cell(dbg, 0, 4, "Pending FVGs (bull/bear)")
    table.cell(dbg, 1, 4, str.tostring(array.size(pendingBull)) + " / " + str.tostring(array.size(pendingBear)))

// ----------------------------------------------------------------------------
// Alerts
// ----------------------------------------------------------------------------
// "Armed" fires the moment the entry zone is known - BEFORE the retracement
// happens - specifically so you can place a resting limit order and walk
// away, instead of needing to be watching for the retracement itself.
// "Invalidated" fires if that setup dies before ever filling, so you know
// to go cancel the resting order rather than leave it live indefinitely.
// Both use alert() (not alertcondition()) so the actual price levels can be
// embedded in the message. To receive these: right-click the indicator ->
// Add alert -> set Condition to "Keen's Indicator v2.1" -> "alert() function
// calls" (not one of the individual conditions) - one alert subscription
// then covers every alert() call below, each with its own live message.
// Long and short each get their own independent message template below -
// edit either one's wording without touching the other.
//
// Cooldown is notification-only - it never touches setupDir/setupEntry/etc,
// so the strategy still anchors and trades exactly as backtested. It only
// decides whether THIS particular armed event is worth pinging your phone
// about, for cases like a choppy sweep-invalidate-sweep cycle firing several
// genuinely-different setups within a couple minutes - each is real, but
// getting buzzed 3 times for what feels like "the same" setup isn't useful.
// lastArmWasNotified pairs the cancel-alert to the armed-alert: you only get
// told to cancel a resting order if you were actually told to place one.
var int  lastAlertBar       = na
var bool lastArmWasNotified = false

// Each message leads with the human-readable line (what shows in a phone
// push notification) followed by a trailing JSON line the execution bot
// parses (it scans for the first "{" in the alert body rather than
// assuming the whole message is JSON) - one alert() call serves both a
// person glancing at their phone and the bot placing the real order.
if justArmed
    notifyThis = na(lastAlertBar) or (bar_index - lastAlertBar) >= alertCooldownBars
    if setupDir == "long"
        longMsg = "🟢 " + syminfo.ticker + " LONG SETUP\n📍 Limit Buy: " + str.tostring(setupEntry, format.mintick) +
          "\n🛑 Stop: " + str.tostring(setupSL, format.mintick) + "\n🎯 Target: " + str.tostring(setupTP, format.mintick) +
          "\n{\"event\":\"armed\",\"symbol\":\"" + syminfo.ticker + "\",\"direction\":\"long\",\"entry\":" +
          str.tostring(setupEntry, format.mintick) + ",\"stop\":" + str.tostring(setupSL, format.mintick) +
          ",\"target\":" + str.tostring(setupTP, format.mintick) + "}"
        if notifyThis
            alert(longMsg, alert.freq_once_per_bar)
    else
        shortMsg = "🔴 " + syminfo.ticker + " SHORT SETUP\n📍 Limit Sell: " + str.tostring(setupEntry, format.mintick) +
          "\n🛑 Stop: " + str.tostring(setupSL, format.mintick) + "\n🎯 Target: " + str.tostring(setupTP, format.mintick) +
          "\n{\"event\":\"armed\",\"symbol\":\"" + syminfo.ticker + "\",\"direction\":\"short\",\"entry\":" +
          str.tostring(setupEntry, format.mintick) + ",\"stop\":" + str.tostring(setupSL, format.mintick) +
          ",\"target\":" + str.tostring(setupTP, format.mintick) + "}"
        if notifyThis
            alert(shortMsg, alert.freq_once_per_bar)
    if notifyThis
        lastAlertBar := bar_index
    lastArmWasNotified := notifyThis

if justInvalidated and lastArmWasNotified
    if setupDir == "long"
        alert("⚪ " + syminfo.ticker + " LONG invalidated\n❌ Cancel your resting BUY order" +
          "\n{\"event\":\"invalidated\",\"symbol\":\"" + syminfo.ticker + "\",\"direction\":\"long\"}", alert.freq_once_per_bar)
    else
        alert("⚪ " + syminfo.ticker + " SHORT invalidated\n❌ Cancel your resting SELL order" +
          "\n{\"event\":\"invalidated\",\"symbol\":\"" + syminfo.ticker + "\",\"direction\":\"short\"}", alert.freq_once_per_bar)

alertcondition(justEntered and tradeIsLong, title = "Keen's Indicator Long Entry (filled)", message = "Keen's Indicator LONG filled — check chart for SL/TP")
alertcondition(justEntered and not tradeIsLong, title = "Keen's Indicator Short Entry (filled)", message = "Keen's Indicator SHORT filled — check chart for SL/TP")
