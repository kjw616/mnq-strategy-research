//@version=6

// ============================================================================
// MNQ ICT A+ SETUP FINDER
// ============================================================================
// Run this on an intraday LTF MNQ chart (1-5 min). It pulls 1H/4H structure
// in via request.security() for bias/POI context, then does all entry-
// trigger work locally on whatever timeframe the chart itself is set to.
// Timing inputs below are specified in MINUTES and auto-convert to the
// right bar count for your chart's timeframe, so switching between e.g.
// 1M and 5M doesn't silently change what a "20 minute timeout" means.
//
// PIPELINE (matches the 3-step trading plan this was built from):
//   Step 1: 4H + 1H market structure -> trade bias (4H always wins on conflict)
//   Step 2: untapped 1H/4H FVG or Rejection Block, in the bias direction,
//           on the side of price the market would have to "chase" toward
//   Step 3: LTF MSS (close through a recent swing) + retest of the LTF
//           FVG/IFVG created by that move -> entry trigger
//
// This version only flags the entry coordinate + direction. It does NOT
// compute TP/SL or a win rate - risk management is left to you.
//
// HOW TO GET PHONE ALERTS (Pine code cannot push notifications by itself):
//   1. Add this indicator to your chart.
//   2. Click the clock/alarm icon (or right-click chart -> Add Alert).
//   3. Condition = this indicator, then choose "A+ Long Setup" or
//      "A+ Short Setup" (or both, as two separate alerts).
//   4. Trigger = "Once Per Bar Close" (avoids repaint-style false pings).
//   5. Under Notifications, check "App notification" (requires the
//      TradingView mobile app installed + notifications enabled).
//   6. Alerts only actually fire during your NY/Asia session windows below,
//      even though setups are detected and drawn on chart at all times.
// ============================================================================

indicator("MNQ ICT A+ Setup Finder", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ----------------------------------------------------------------------------
// INPUTS
// ----------------------------------------------------------------------------
grpSession = "Session Windows (used only to gate phone alerts)"
sessNy    = input.session("0900-1100", "NY Session", group = grpSession)
sessAsia  = input.session("2000-2200", "Asia Session", group = grpSession)
sessTz    = input.string("America/New_York", "Session Timezone", group = grpSession)

grpStruct = "Market Structure"
htfPivotLen = input.int(5, "HTF Pivot Lookback (1H / 4H swings)", minval = 2, group = grpStruct)
minSwingAtrMult = input.float(0.5, "Min MSS pullback depth (x chart ATR14)", minval = 0, group = grpStruct)

grpPda = "PD Arrays"
minHtfFvgPts   = input.float(5.0, "Min 1H/4H FVG size (points)", minval = 0, group = grpPda)
minLtfFvgPts   = input.float(1.0, "Min LTF FVG size (points)", minval = 0, group = grpPda)
rbWickRatio    = input.float(2.0, "Rejection Block min wick:body ratio", minval = 1.0, group = grpPda)
poiMaxAgeMin   = input.int(1000, "HTF POI / LTF zone max age (minutes) before stale", minval = 1, group = grpPda)
maxPoisTracked = input.int(3, "Max untapped POIs tracked per direction", minval = 1, maxval = 10, group = grpPda)

grpTiming = "Timing / Timeouts (minutes - auto-converted to bars for your chart TF)"
reactionWindowMin = input.int(100, "Minutes allowed: POI-touch -> MSS -> entry", minval = 1, group = grpTiming)
fvgSearchMin       = input.int(25, "Minutes around MSS to search for LTF FVG/IFVG", minval = 1, group = grpTiming)

grpVis = "Visuals"
showHtfPoiBoxes  = input.bool(true, "Show HTF POI box", group = grpVis)
showLtfPoiBoxes  = input.bool(true, "Show LTF entry zone box", group = grpVis)
showStatsTable   = input.bool(true, "Show status table", group = grpVis)
bullColor        = input.color(color.new(color.teal, 0), "Bullish color", group = grpVis)
bearColor        = input.color(color.new(color.red, 0), "Bearish color", group = grpVis)

// ----------------------------------------------------------------------------
// TYPES
// ----------------------------------------------------------------------------
type Poi
    float  top
    float  bottom
    string dir          // "bull" or "bear"
    string kind         // "FVG", "RB", "IFVG"
    string tf           // "1H", "4H", "LTF"
    int    barCreated
    bool   mitigated = false
    bool   flipped   = false

// ----------------------------------------------------------------------------
// PERSISTENT STATE
// ----------------------------------------------------------------------------
var array<Poi> htfPool = array.new<Poi>()
var array<Poi> ltfZones = array.new<Poi>()

var int ST_SEARCH      = 0
var int ST_POI_ACTIVE  = 1
var int ST_ARMED_MSS   = 2
var int ST_AWAIT_ENTRY = 3

var int   fsmState           = ST_SEARCH
var Poi   activePoi          = na
var Poi   entryZoneObj       = na
var int   poiReachedBar      = na
var int   mssBarIdx          = na
var int   lastBiasAtSelection = na
var float armedExtreme       = na
var float armedSwingRef      = na

var box entryHtfBox = na
var box entryLtfBox = na

var int totalSetups = 0

var int lastT1h = na
var int lastT4h = na

// ----------------------------------------------------------------------------
// HELPER FUNCTIONS
// ----------------------------------------------------------------------------

// Confirmed-swing structure classifier. Runs inside request.security() so its
// `var` state is tracked per higher timeframe automatically.
f_structureBias(len) =>
    ph = ta.pivothigh(len, len)
    pl = ta.pivotlow(len, len)
    var float lastHigh = na
    var float prevHigh = na
    var float lastLow  = na
    var float prevLow  = na
    var int   bias     = 0
    if not na(ph)
        prevHigh := lastHigh
        lastHigh := ph
    if not na(pl)
        prevLow := lastLow
        lastLow := pl
    bullStruct = not na(lastHigh) and not na(prevHigh) and not na(lastLow) and not na(prevLow) and lastHigh > prevHigh and lastLow > prevLow
    bearStruct = not na(lastHigh) and not na(prevHigh) and not na(lastLow) and not na(prevLow) and lastHigh < prevHigh and lastLow < prevLow
    if bullStruct
        bias := 1
    else if bearStruct
        bias := -1
    [bias, lastHigh, lastLow]

// Bundles the raw OHLC + time needed for FVG/RB detection on a HTF.
f_htfCtx() =>
    [high, high[1], high[2], low, low[1], low[2], open, close, time]

f_checkFvg(h0, l0, h2, l2, minSize) =>
    gapBull = l0 - h2
    gapBear = l2 - h0
    bullFvg = gapBull > 0 and gapBull >= minSize
    bearFvg = gapBear > 0 and gapBear >= minSize
    [bullFvg, bearFvg]

f_checkRb(o0, h0, l0, c0, recentSwingHigh, recentSwingLow, wickRatio) =>
    body = math.abs(c0 - o0)
    upperWick = h0 - math.max(o0, c0)
    lowerWick = math.min(o0, c0) - l0
    bearRb = not na(recentSwingHigh) and h0 > recentSwingHigh and c0 < recentSwingHigh and (body == 0 ? upperWick > 0 : upperWick >= wickRatio * body)
    bullRb = not na(recentSwingLow) and l0 < recentSwingLow and c0 > recentSwingLow and (body == 0 ? lowerWick > 0 : lowerWick >= wickRatio * body)
    [bullRb, bearRb]

f_addPoi(array<Poi> pool, float top, float bottom, string dir, string kind, string tf) =>
    pool.push(Poi.new(top, bottom, dir, kind, tf, bar_index))

f_trimPool(array<Poi> pool, int maxKeep) =>
    while pool.size() > maxKeep
        idxToRemove = -1
        for i = 0 to pool.size() - 1
            if pool.get(i).mitigated
                idxToRemove := i
                break
        if idxToRemove == -1
            idxToRemove := 0
        pool.remove(idxToRemove)

f_updateHtfMitigation(array<Poi> pool, float barHigh, float barLow, int maxAge) =>
    if pool.size() > 0
        for i = 0 to pool.size() - 1
            p = pool.get(i)
            if not p.mitigated
                if barLow <= p.top and barHigh >= p.bottom
                    p.mitigated := true
                else if bar_index - p.barCreated > maxAge
                    p.mitigated := true

f_selectPoi(array<Poi> pool, string wantDir, float refPrice) =>
    float bestDist = na
    Poi best = na
    if pool.size() > 0
        for i = 0 to pool.size() - 1
            p = pool.get(i)
            if not p.mitigated and p.dir == wantDir
                valid = wantDir == "bull" ? p.top < refPrice : p.bottom > refPrice
                if valid
                    dist = wantDir == "bull" ? (refPrice - p.top) : (p.bottom - refPrice)
                    if na(bestDist) or dist < bestDist
                        bestDist := dist
                        best := p
    best

f_updateLtfZones(array<Poi> pool, float c, int maxAge) =>
    n = pool.size()
    if n > 0
        for i = 0 to n - 1
            p = pool.get(i)
            if not p.mitigated
                if p.dir == "bull" and c < p.bottom
                    p.mitigated := true
                    f_addPoi(pool, p.top, p.bottom, "bear", "IFVG", "LTF")
                    true
                else if p.dir == "bear" and c > p.top
                    p.mitigated := true
                    f_addPoi(pool, p.top, p.bottom, "bull", "IFVG", "LTF")
                    true
                else if bar_index - p.barCreated > maxAge
                    p.mitigated := true
                    true

f_selectEntryZone(array<Poi> pool, string wantDir, int mssBar, int searchWindow) =>
    Poi best = na
    if pool.size() > 0
        for i = pool.size() - 1 to 0
            p = pool.get(i)
            if not p.mitigated and p.dir == wantDir and p.barCreated >= mssBar - searchWindow
                best := p
                break
    best

f_biasText(b) =>
    b == 1 ? "🟢 Bullish" : b == -1 ? "🔴 Bearish" : "⚪ Neutral"

f_biasColor(b) =>
    b == 1 ? color.new(color.lime, 0) : b == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)

// ----------------------------------------------------------------------------
// TOP-LEVEL DATA REQUESTS (must stay unconditional / outside loops & ifs)
// ----------------------------------------------------------------------------
[bias1H, hi1H, lo1H] = request.security(syminfo.tickerid, "60", f_structureBias(htfPivotLen), lookahead = barmerge.lookahead_off)
[bias4H, hi4H, lo4H] = request.security(syminfo.tickerid, "240", f_structureBias(htfPivotLen), lookahead = barmerge.lookahead_off)

[h0_1h, h1_1h, h2_1h, l0_1h, l1_1h, l2_1h, o0_1h, c0_1h, t0_1h] = request.security(syminfo.tickerid, "60", f_htfCtx(), lookahead = barmerge.lookahead_off)
[h0_4h, h1_4h, h2_4h, l0_4h, l1_4h, l2_4h, o0_4h, c0_4h, t0_4h] = request.security(syminfo.tickerid, "240", f_htfCtx(), lookahead = barmerge.lookahead_off)

atr14 = ta.atr(14)

// Convert minute-based timing inputs into a bar count for whatever timeframe
// the chart is actually on, so these stay calibrated in real time whether
// you're running this on a 1M, 2M, or 5M chart.
barSeconds = timeframe.in_seconds(timeframe.period)
reactionWindowBars = int(math.max(1, math.round(reactionWindowMin * 60 / barSeconds)))
fvgSearchBars = int(math.max(1, math.round(fvgSearchMin * 60 / barSeconds)))
poiMaxAgeBars = int(math.max(1, math.round(poiMaxAgeMin * 60 / barSeconds)))

// ----------------------------------------------------------------------------
// BIAS
// ----------------------------------------------------------------------------
finalBias = bias4H != 0 ? bias4H : bias1H

// Session gating (used for alerts only, not for detection)
inNySession   = not na(time(timeframe.period, sessNy + ":1234567", sessTz))
inAsiaSession = not na(time(timeframe.period, sessAsia + ":1234567", sessTz))
inSession = inNySession or inAsiaSession

// ----------------------------------------------------------------------------
// PER-BAR PROCESSING (gated on confirmed bars only -> non-repainting signals)
// ----------------------------------------------------------------------------
bool longTrig  = false
bool shortTrig = false
float entryPriceThisBar = na

if barstate.isconfirmed
    newBar1h = t0_1h != lastT1h
    newBar4h = t0_4h != lastT4h

    // --- Step 2: HTF POI detection on fresh HTF bar closes ---
    if newBar1h
        [bullFvg1h, bearFvg1h] = f_checkFvg(h0_1h, l0_1h, h2_1h, l2_1h, minHtfFvgPts)
        [bullRb1h, bearRb1h]   = f_checkRb(o0_1h, h0_1h, l0_1h, c0_1h, hi1H, lo1H, rbWickRatio)
        if bullFvg1h
            f_addPoi(htfPool, l0_1h, h2_1h, "bull", "FVG", "1H")
        if bearFvg1h
            f_addPoi(htfPool, l2_1h, h0_1h, "bear", "FVG", "1H")
        if bullRb1h
            f_addPoi(htfPool, math.min(o0_1h, c0_1h), l0_1h, "bull", "RB", "1H")
        if bearRb1h
            f_addPoi(htfPool, h0_1h, math.max(o0_1h, c0_1h), "bear", "RB", "1H")

    if newBar4h
        [bullFvg4h, bearFvg4h] = f_checkFvg(h0_4h, l0_4h, h2_4h, l2_4h, minHtfFvgPts)
        [bullRb4h, bearRb4h]   = f_checkRb(o0_4h, h0_4h, l0_4h, c0_4h, hi4H, lo4H, rbWickRatio)
        if bullFvg4h
            f_addPoi(htfPool, l0_4h, h2_4h, "bull", "FVG", "4H")
        if bearFvg4h
            f_addPoi(htfPool, l2_4h, h0_4h, "bear", "FVG", "4H")
        if bullRb4h
            f_addPoi(htfPool, math.min(o0_4h, c0_4h), l0_4h, "bull", "RB", "4H")
        if bearRb4h
            f_addPoi(htfPool, h0_4h, math.max(o0_4h, c0_4h), "bear", "RB", "4H")

    f_updateHtfMitigation(htfPool, high, low, poiMaxAgeBars)
    f_trimPool(htfPool, maxPoisTracked * 4)

    // --- Step 3 prep: LTF FVG / IFVG pool ---
    [bullLtfFvg, bearLtfFvg] = f_checkFvg(high, low, high[2], low[2], minLtfFvgPts)
    if bullLtfFvg
        f_addPoi(ltfZones, low, high[2], "bull", "FVG", "LTF")
    if bearLtfFvg
        f_addPoi(ltfZones, low[2], high, "bear", "FVG", "LTF")
    f_updateLtfZones(ltfZones, close, poiMaxAgeBars)
    f_trimPool(ltfZones, 30)

    // --- Bias flip safety reset ---
    if fsmState != ST_SEARCH and not na(lastBiasAtSelection) and finalBias != lastBiasAtSelection
        fsmState := ST_SEARCH
        activePoi := na
        entryZoneObj := na

    // --- FSM ---
    if fsmState == ST_SEARCH and finalBias != 0
        candidate = f_selectPoi(htfPool, finalBias == 1 ? "bull" : "bear", close)
        if not na(candidate)
            activePoi := candidate
            lastBiasAtSelection := finalBias
            fsmState := ST_POI_ACTIVE

    if fsmState == ST_POI_ACTIVE and not na(activePoi)
        reached = low <= activePoi.top and high >= activePoi.bottom
        if reached
            activePoi.mitigated := true
            poiReachedBar := bar_index
            armedExtreme := activePoi.dir == "bull" ? low : high
            armedSwingRef := na
            fsmState := ST_ARMED_MSS
            true
        else if activePoi.mitigated or (bar_index - activePoi.barCreated > poiMaxAgeBars)
            fsmState := ST_SEARCH
            activePoi := na
            true

    if fsmState == ST_ARMED_MSS and not na(activePoi)
        isLong2 = activePoi.dir == "bull"
        // MSS is checked against the swing established BEFORE this bar -
        // the tracker below only updates it for bars AFTER this check, so
        // a bar can never "break" a swing level it just created itself.
        // The pullback must also be at least minSwingAtrMult x ATR deep -
        // otherwise a 1-2 tick wiggle counts as "the swing" just as much as
        // a real reaction, which was letting MSS fire on pure noise.
        swingDepth = na(armedSwingRef) ? na : (isLong2 ? (armedSwingRef - armedExtreme) : (armedExtreme - armedSwingRef))
        swingBigEnough = not na(swingDepth) and swingDepth >= minSwingAtrMult * atr14
        bullMss = isLong2 and swingBigEnough and close[1] <= armedSwingRef and close > armedSwingRef
        bearMss = (not isLong2) and swingBigEnough and close[1] >= armedSwingRef and close < armedSwingRef
        if bullMss or bearMss
            mssBarIdx := bar_index
            fsmState := ST_AWAIT_ENTRY
            true
        else
            // Track the local peak/trough since the POI was touched, and
            // the pullback level that forms after it - that pullback is
            // the "key swing" the MSS needs to break. Anchoring this to
            // the POI reaction (instead of a possibly-stale older pivot)
            // keeps the eventual entry close to the HTF array.
            if isLong2
                if low < armedExtreme
                    armedExtreme := low
                    armedSwingRef := na
                else if na(armedSwingRef) or high > armedSwingRef
                    armedSwingRef := high
            else
                if high > armedExtreme
                    armedExtreme := high
                    armedSwingRef := na
                else if na(armedSwingRef) or low < armedSwingRef
                    armedSwingRef := low
            if bar_index - poiReachedBar > reactionWindowBars
                fsmState := ST_SEARCH
                activePoi := na
            true

    if fsmState == ST_AWAIT_ENTRY and not na(activePoi)
        if na(entryZoneObj)
            entryZoneObj := f_selectEntryZone(ltfZones, activePoi.dir, mssBarIdx, fvgSearchBars)
        if not na(entryZoneObj)
            retest = low <= entryZoneObj.top and high >= entryZoneObj.bottom
            if retest
                isLong = activePoi.dir == "bull"
                entryPriceThisBar := close
                longTrig := isLong
                shortTrig := not isLong
                totalSetups += 1
                fsmState := ST_SEARCH
                activePoi := na
                entryZoneObj := na
        if bar_index - mssBarIdx > reactionWindowBars
            fsmState := ST_SEARCH
            activePoi := na
            entryZoneObj := na

    lastT1h := t0_1h
    lastT4h := t0_4h

// ----------------------------------------------------------------------------
// VISUALS
// ----------------------------------------------------------------------------
if showHtfPoiBoxes
    if not na(activePoi)
        col = color.new(activePoi.dir == "bull" ? bullColor : bearColor, 85)
        if na(entryHtfBox)
            entryHtfBox := box.new(activePoi.barCreated, activePoi.top, bar_index, activePoi.bottom, border_color = (activePoi.dir == "bull" ? bullColor : bearColor), bgcolor = col)
            true
        else
            box.set_right(entryHtfBox, bar_index)
            box.set_top(entryHtfBox, activePoi.top)
            box.set_bottom(entryHtfBox, activePoi.bottom)
            true
    else if not na(entryHtfBox)
        box.delete(entryHtfBox)
        entryHtfBox := na
        true

if showLtfPoiBoxes
    if not na(entryZoneObj)
        col2 = color.new(entryZoneObj.dir == "bull" ? bullColor : bearColor, 70)
        if na(entryLtfBox)
            entryLtfBox := box.new(entryZoneObj.barCreated, entryZoneObj.top, bar_index, entryZoneObj.bottom, border_color = (entryZoneObj.dir == "bull" ? bullColor : bearColor), bgcolor = col2)
            true
        else
            box.set_right(entryLtfBox, bar_index)
            box.set_top(entryLtfBox, entryZoneObj.top)
            box.set_bottom(entryLtfBox, entryZoneObj.bottom)
            true
    else if not na(entryLtfBox)
        box.delete(entryLtfBox)
        entryLtfBox := na
        true

if longTrig or shortTrig
    dirColor = longTrig ? bullColor : bearColor
    // Push the label clear of the candle range (0.75x ATR) so it doesn't
    // sit on top of price action and get visually buried by later bars.
    labelAnchor = longTrig ? low - atr14 * 0.75 : high + atr14 * 0.75
    labelStyle = longTrig ? label.style_label_up : label.style_label_down
    dirTxt = longTrig ? "🟢 A+ LONG" : "🔴 A+ SHORT"
    txt = dirTxt + "\n📍 Entry " + str.tostring(entryPriceThisBar, format.mintick)
    label.new(bar_index, labelAnchor, txt, style = labelStyle, color = color.new(dirColor, 0), textcolor = color.white, size = size.normal)

if showStatsTable and barstate.islast
    var table infoTable = table.new(position.top_right, 2, 7, border_width = 2, border_color = #000000, frame_width = 2, frame_color = #000000)
    stateText = fsmState == ST_SEARCH ? "🔍 Searching POI" : fsmState == ST_POI_ACTIVE ? "📦 POI Active" : fsmState == ST_ARMED_MSS ? "⚡ Armed for MSS" : "⏳ Awaiting Entry"
    tfMinutes = barSeconds / 60
    tfOk = tfMinutes > 0 and tfMinutes <= 15
    bgSolid = #131722
    bgHeader = #1e2a3a

    table.cell(infoTable, 0, 0, "📊 MNQ A+ Setup Finder", text_color = color.white, bgcolor = bgHeader, text_size = size.normal)
    table.cell(infoTable, 1, 0, "", bgcolor = bgHeader)
    table.cell(infoTable, 0, 1, "🕓 4H Bias", text_color = color.white, bgcolor = bgSolid)
    table.cell(infoTable, 1, 1, f_biasText(bias4H), text_color = f_biasColor(bias4H), bgcolor = bgSolid)
    table.cell(infoTable, 0, 2, "⏱️ 1H Bias", text_color = color.white, bgcolor = bgSolid)
    table.cell(infoTable, 1, 2, f_biasText(bias1H), text_color = f_biasColor(bias1H), bgcolor = bgSolid)
    table.cell(infoTable, 0, 3, "🎯 Trade Bias", text_color = color.white, bgcolor = bgSolid)
    table.cell(infoTable, 1, 3, f_biasText(finalBias), text_color = f_biasColor(finalBias), bgcolor = bgSolid)
    table.cell(infoTable, 0, 4, "🔎 Status", text_color = color.white, bgcolor = bgSolid)
    table.cell(infoTable, 1, 4, stateText, text_color = color.white, bgcolor = bgSolid)
    table.cell(infoTable, 0, 5, "📈 Chart TF", text_color = color.white, bgcolor = bgSolid)
    table.cell(infoTable, 1, 5, timeframe.period + (tfOk ? "m ✅" : "m ⚠️ (too high)"), text_color = tfOk ? color.new(color.lime, 0) : color.new(color.orange, 0), bgcolor = bgSolid)
    table.cell(infoTable, 0, 6, "🏆 Setups Found", text_color = color.white, bgcolor = bgSolid)
    table.cell(infoTable, 1, 6, str.tostring(totalSetups), text_color = color.white, bgcolor = bgSolid)

// ----------------------------------------------------------------------------
// ALERTS (create the actual TradingView alert from the UI - see header notes)
// ----------------------------------------------------------------------------
alertcondition(longTrig and inSession, title = "A+ Long Setup", message = "MNQ A+ LONG setup — check chart for entry coordinate")
alertcondition(shortTrig and inSession, title = "A+ Short Setup", message = "MNQ A+ SHORT setup — check chart for entry coordinate")
