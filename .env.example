# Copy to .env and fill in real values - .env is gitignored, this file is not.

DATABENTO_API_KEY=

# Tradovate API credentials (Application Settings -> Add-Ons -> API Access
# on tradovate.com, after purchasing the API add-on). cid/sec are the
# client id/secret issued when you generate your API key; app_id/app_version
# identify this application to Tradovate (any consistent string is fine,
# e.g. "KeensIndicatorBot" / "1.0"). device_id can be any stable unique
# string you generate once (e.g. a random UUID) - Tradovate uses it for
# device-level MFA/session tracking.
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_DEVICE_ID=

# Any long random string you make up yourself - this becomes the secret
# segment of your webhook URL (https://<host>/webhook/<this value>).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SHARED_SECRET=
